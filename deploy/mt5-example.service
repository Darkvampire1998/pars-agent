# Example only. Adjust paths/user after installing MT5 and logging in through a desktop.
# Create a separate OS user + Wine prefix + service for EACH concurrently connected account.
[Unit]
Description=Pars Agent MT5 terminal under Wine
After=network-online.target
Wants=network-online.target

[Service]
User=mt5
Environment=WINEPREFIX=/home/mt5/.mt5
ExecStart=/usr/bin/xvfb-run -a /usr/bin/wine "/home/mt5/.mt5/drive_c/Program Files/MetaTrader 5/terminal64.exe"
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
