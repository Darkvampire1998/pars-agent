{
	default_sni {$DOMAIN}
}

https://{$PANEL_HOST} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	request_body {
		max_size 400KB
	}
	reverse_proxy app:8000 {
		header_up X-Pars-Client-IP {remote_host}
	}
}

http://{$PANEL_HOST} {
	redir {$PUBLIC_URL}{uri} permanent
}
